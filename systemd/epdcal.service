[Unit]
Description=EPD ICS Calendar Display Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=@PREFIX@/bin/@BINARY@ --config @ETCDIR@/config.yaml
WorkingDirectory=@VARLIB@
User=@SERVICE_USER@
Group=@SERVICE_GROUP@
SupplementaryGroups=gpio
SupplementaryGroups=i2c
Restart=on-failure
RestartSec=5s
ExecStartPre=/bin/sleep 60
EnvironmentFile=-@ENVFILE@

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectControlGroups=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictNamespaces=true

# Allow writes to the config directory and runtime state.
ReadWritePaths=@ETCDIR@ @VARLIB@

# The internal renderer has no JIT; prohibit writable-executable memory.
MemoryDenyWriteExecute=true

# GPIO access for the Waveshare controller.
DeviceAllow=/dev/gpiochip0 rw
DeviceAllow=/dev/gpiochip4 rw

# I2C access for the battery reader (e.g. PiSugar).
DeviceAllow=/dev/i2c-1 rw

Environment=HOME=@VARLIB@

# If you need to bind a privileged port (<1024), uncomment:
# AmbientCapabilities=CAP_NET_BIND_SERVICE

# 로그는 journalctl -u epdcal 로 확인
# API 키 등 비밀값은 /etc/default/epdcal 에 설정한다.

[Install]
WantedBy=multi-user.target
