[Unit]
Description=EPD ICS Calendar Display Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=@PREFIX@/bin/@BINARY@ --config @ETCDIR@/config.yaml
WorkingDirectory=@VARLIB@
User=@SERVICE_USER@
Group=@SERVICE_GROUP@
SupplementaryGroups=gpio
SupplementaryGroups=i2c
Restart=on-failure
RestartSec=5s
ExecStartPre=/bin/sleep 60

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectControlGroups=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictNamespaces=true

# Allow writes to the config directory and runtime state.
ReadWritePaths=@ETCDIR@ @VARLIB@

# Chromium in this project needs executable memory for the browser process.
# Leave MDWE off in the default unit so headless capture can start reliably.
MemoryDenyWriteExecute=false

# GPIO access for the Waveshare controller.
DeviceAllow=/dev/gpiochip0 rw
DeviceAllow=/dev/gpiochip4 rw

# I2C access for the battery reader (e.g. PiSugar).
DeviceAllow=/dev/i2c-1 rw

# Keep HOME inside the writable state dir for Chromium/temp profile behavior.
Environment=HOME=@VARLIB@

# If you need to bind a privileged port (<1024), uncomment:
# AmbientCapabilities=CAP_NET_BIND_SERVICE

# 로그는 journalctl -u epdcal 로 확인
# 필요 시 환경 변수 파일을 추가해서 옵션을 오버라이드할 수 있다.
# 예)
# EnvironmentFile=-/etc/default/epdcal
# ExecStart=@PREFIX@/bin/@BINARY@ $EPDCAL_FLAGS

[Install]
WantedBy=multi-user.target
