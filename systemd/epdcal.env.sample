# Optional OpenWeather One Call API 4.0 key.
# Add your key after the equals sign, without quotes:
EPDCAL_OPENWEATHER_API_KEY=

# Optional explicit fonts (absolute paths). If unset, epdcal scans system fonts.
# EPDCAL_FONT_REGULAR=/usr/share/fonts/truetype/nanum/NanumGothic.ttf
# EPDCAL_FONT_BOLD=/usr/share/fonts/truetype/nanum/NanumGothicBold.ttf
