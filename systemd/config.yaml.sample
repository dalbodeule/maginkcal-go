listen: "127.0.0.1:8080"
timezone: "Asia/Seoul"

# Cron schedule for periodic refresh (every 15 minutes by default).
refresh: "*/15 * * * *"

horizon_days: 7
show_all_day: true

# monday | sunday
week_start: "monday"

# 90 (clockwise) | 270 (counter-clockwise)
rotation: 90

default_locale: "ko"

# Optional system font family preference. Blank uses automatic Korean font selection.
# Examples: "나눔고딕", "Noto Sans KR". EPDCAL_FONT_REGULAR overrides this setting.
font_family: "Nanum Gothic"

# Built-in calendar layout. Edit this JSON in the Web UI or here.
layout_json: |
  {
    "show_weather": true,
    "show_battery": true,
    "show_event_times": true,
    "show_empty_days": true,
    "max_events_per_day": 3,
    "header_font_size": 36,
    "date_font_size": 16,
    "event_font_size": 12,
    "grid_top": 179,
    "assets": []
  }

# Keywords that should be rendered in the red plane.
highlight_red:
  - "휴일"
  - "휴가"
  - "중요"

# An event is a holiday when its title starts with one of these prefixes.
# Use [] to disable the rule.
holiday_prefixes:
  - "쉬는 날"

# Optional Basic Auth for Web UI/API (all endpoints except /health).
# basic_auth:
#   username: "admin"
#   password: "change-me"

# ICS subscription sources.
ics:
  - id: "personal"
    name: "Personal"
    url: "https://example.com/calendar.ics"
