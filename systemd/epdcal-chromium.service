[Unit]
Description=EPD ICS Calendar Display Service (Chromium Compatibility)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=@PREFIX@/bin/@BINARY@ --config @ETCDIR@/config.yaml
WorkingDirectory=@VARLIB@
User=@SERVICE_USER@
Group=@SERVICE_GROUP@
Restart=on-failure
RestartSec=5s

# Looser hardening profile for environments where Chromium startup is picky.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectControlGroups=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
LockPersonality=true
RestrictRealtime=true

# Chromium compatibility: relax the restrictions that most often interfere
# with headless browser startup under systemd.
MemoryDenyWriteExecute=false
RestrictSUIDSGID=false
RestrictNamespaces=false

# Allow writes to the config directory and runtime state.
ReadWritePaths=@ETCDIR@ @VARLIB@
Environment=HOME=@VARLIB@

# If you need to bind a privileged port (<1024), uncomment:
# AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
